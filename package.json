{
  "name": "prism-browser",
  "version": "0.3.26",
  "private": true,
  "author": {
    "name": "XRSec",
    "url": "https://github.com/XRSec"
  },
  "description": "Open-source local-first multi-profile fingerprint browser",
  "keywords": [
    "pi-package",
    "claude-plugin",
    "agent-plugin",
    "antigravity-plugin",
    "fingerprint-browser",
    "automation",
    "mcp"
  ],
  "pi": {
    "skills": [
      "./resources/skills"
    ],
    "prompts": [
      "./resources/prompts"
    ]
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win msi portable zip --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run --fileParallelism=false && npm run kernel:verify-lock",
    "test:lifecycle": "vitest run --fileParallelism=false src/main/app-session.test.ts src/main/browser-launcher.test.ts src/main/process-inspector.integration.test.ts",
    "test:watch": "vitest",
    "audit:fingerprint": "node tools/fingerprint-audit/run.mjs",
    "audit:pixelscan": "node tools/pixelscan-online-probe/run.mjs",
    "audit:fingerprint-matrix": "node tools/fingerprint-matrix/run.mjs",
    "audit:network": "node tools/network-audit/run.mjs",
    "audit:profile-data": "node tools/profile-data-audit/run.mjs",
    "audit:stress": "node tools/multi-profile-stress/run.mjs",
    "audit:app-e2e": "node tools/app-e2e/run.mjs",
    "accept:windows": "node tools/windows-acceptance/run.cjs",
    "accept:local-summary": "node tools/local-acceptance/aggregate.mjs",
    "analyze:soak": "node tools/runtime-soak/analyze.cjs",
    "kernel:verify-lock": "node tools/kernel-maintenance/run.mjs verify-lock",
    "kernel:probe-upstream": "node tools/kernel-maintenance/run.mjs probe-upstream --output release/kernel-upstream.json",
    "kernel:export-kits": "node tools/kernel-maintenance/run.mjs export-kits --kits-output release/kernel-build-kits",
    "release:update-manifest": "node tools/release/create-update-manifest.mjs",
    "beta:export-kit": "node tools/beta-acceptance/export-kit.mjs",
    "beta:verify-kit": "node tools/beta-acceptance/verify-kit.mjs",
    "beta:verify-candidate": "node tools/release/verify-update-candidate.mjs",
    "beta:validate-evidence": "node tools/beta-acceptance/validate-evidence.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "antd": "^6.7.0",
    "proxy-chain": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "build": {
    "appId": "com.xrsec.prismbrowser",
    "productName": "Prism Browser",
    "copyright": "Copyright © 2026 Prism Browser. All rights reserved.",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pro-agent",
        "to": "pro-agent"
      },
      {
        "from": "resources/plugin",
        "to": "plugin"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/license-config.json",
        "to": "license-config.json"
      },
      {
        "from": "resources/window-sync",
        "to": "window-sync"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "signIgnore": "[/\\\\]Contents[/\\\\]Resources[/\\\\](?:kernels[/\\\\](?:current|available[/\\\\]\\d+(?:\\.\\d+){3})[/\\\\]Chromium\\.app|pro-agent[/\\\\]prism-pro-agent(?:-[A-Za-z0-9._-]+)?|window-sync[/\\\\]prism-window-sync-helper)(?:[/\\\\]|$)"
    },
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        "msi",
        "portable",
        "zip"
      ]
    },
    "msi": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "runAfterFinish": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Prism Browser"
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRSec/Prism-Browser.git"
  },
  "homepage": "https://github.com/XRSec/Prism-Browser#readme",
  "bugs": {
    "url": "https://github.com/XRSec/Prism-Browser/issues"
  }
}
